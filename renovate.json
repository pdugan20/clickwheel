{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "pep621", "github-actions"],
  "constraints": {
    "uv": "0.11.17"
  },
  "timezone": "America/Los_Angeles",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": true,
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "branchConcurrentLimit": 2,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Default every enabled manager to dashboard approval",
      "matchManagers": ["npm", "pep621", "github-actions"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Python direct dependencies update uv.lock in range",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Stable Python runtime non-major updates",
      "matchManagers": ["pep621"],
      "matchFileNames": ["pyproject.toml"],
      "matchDepTypes": ["project.dependencies"],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "python runtime dependencies",
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": false,
      "automerge": true
    },
    {
      "description": "Python optional, development, and build dependencies need coverage proof",
      "matchManagers": ["pep621"],
      "matchDepTypes": [
        "project.optional-dependencies",
        "dependency-groups",
        "build-system.requires",
        "tool.pdm.dev-dependencies",
        "tool.uv.dev-dependencies"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "npm roots require generated-output or CI-contract proof",
      "matchManagers": ["npm"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "GitHub Actions require immutable-pin policy reconciliation",
      "matchManagers": ["github-actions"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Pre-1.0 minor updates require exception handling",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "All major updates require exception handling",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Pins, digests, and lock maintenance always require manual approval",
      "matchUpdateTypes": ["pin", "pinDigest", "digest", "lockFileMaintenance"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
