{
  "$schema": "https://mintlify.com/schema.json",
  "theme": "maple",
  "name": "clickwheel",
  "description": "Sync your music library to a classic iPod from a modern Mac, with optional Claude/MCP control.",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "colors": {
    "primary": "#4A82EF",
    "light": "#C4DCFF",
    "dark": "#4A82EF"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/pdugan20/clickwheel"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/pdugan20/clickwheel"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["introduction", "quickstart", "requirements"]
          },
          {
            "group": "How-to guides",
            "pages": [
              "guides/sync-to-ipod",
              "guides/playlists",
              "guides/plex",
              "guides/apple-music",
              "guides/scrobbling",
              "guides/fix-metadata",
              "guides/remote-mcp"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/design",
              "concepts/mcp-server"
            ]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting", "changelog"]
          }
        ]
      },
      {
        "tab": "Reference",
        "pages": [
          {
            "group": "CLI",
            "pages": [
              "reference/cli",
              "reference/cli/library",
              "reference/cli/playlists",
              "reference/cli/ipod",
              "reference/cli/plex",
              "reference/cli/apple-music",
              "reference/cli/lastfm"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "reference/mcp-tools",
              "reference/mcp-tools/library",
              "reference/mcp-tools/playlists",
              "reference/mcp-tools/ipod",
              "reference/mcp-tools/plex",
              "reference/mcp-tools/apple-music",
              "reference/mcp-tools/lastfm"
            ]
          },
          "reference/configuration"
        ]
      }
    ]
  }
}
