{
  "name": "clickwheel-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Apps UI bundles for the clickwheel MCP server.",
  "scripts": {
    "dev": "vite --config workbench/vite.config.ts",
    "build:bundles": "node scripts/inline_bundles.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@modelcontextprotocol/ext-apps": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "overrides": {
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=5": "5.0.9",
    "fast-uri": "3.1.5",
    "ip-address": "10.4.0",
    "js-yaml@>=4": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
